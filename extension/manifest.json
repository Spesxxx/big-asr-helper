{
  "manifest_version": 3,
  "name": "Big ASR 标注助手 (17语种 SOP)",
  "version": "1.0.14",
  "description": "面向 AIDP Big ASR 测试集（17语种）的半自动标注、强制对齐切分与 SOP 第12节提交前全检助手。绝不自动提交。",
  "key": "",
  "permissions": [
    "storage",
    "debugger",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://aidp.byteintl.com/*",
    "https://*.bytetos.com/*",
    "https://quanzil.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aidp.byteintl.com/management/paas/task-v2/*/mark-v3/*"
      ],
      "js": [
        "config.js",
        "sop_rules.js",
        "audio_vad.js",
        "dom_adapter.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
